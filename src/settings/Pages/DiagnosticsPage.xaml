<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SmoothEverything.Settings.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="900" Padding="32,28,32,48" Spacing="22" HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="诊断" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="查看引擎连接、输入计数和失败保护状态。" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Center" Content="启动引擎" Click="StartEngine_Click" />
                <Button Grid.Column="2" VerticalAlignment="Center" Content="刷新" Click="Refresh_Click" />
            </Grid>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="EngineStatusIcon" Glyph="&#xE9D9;" FontSize="28" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock x:Name="EngineStatusTitle" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="EngineStatusDetail" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="本次运行统计" />
                <Grid ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource SettingsCardStyle}" Padding="16">
                        <StackPanel Spacing="4"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="物理输入" /><TextBlock x:Name="PhysicalEventsValue" FontSize="24" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SettingsCardStyle}" Padding="16">
                        <StackPanel Spacing="4"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="已平滑" /><TextBlock x:Name="SmoothedEventsValue" FontSize="24" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource SettingsCardStyle}" Padding="16">
                        <StackPanel Spacing="4"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="直接放行" /><TextBlock x:Name="PassedEventsValue" FontSize="24" FontWeight="SemiBold" /></StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource SettingsCardStyle}" Padding="16">
                        <StackPanel Spacing="4"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="注入帧" /><TextBlock x:Name="InjectedEventsValue" FontSize="24" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingsCardStyle}" Padding="16">
                        <StackPanel Spacing="4"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="注入总位移" /><TextBlock x:Name="InjectedDeltaValue" FontSize="24" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource SettingsCardStyle}" Padding="16">
                        <StackPanel Spacing="4"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="目标切换" /><TextBlock x:Name="TargetChangesValue" FontSize="24" FontWeight="SemiBold" /></StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource SettingsCardStyle}" Padding="16">
                        <StackPanel Spacing="4"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="队列溢出" /><TextBlock x:Name="QueueOverflowsValue" FontSize="24" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource SettingsCardStyle}" Padding="16">
                        <StackPanel Spacing="4"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="注入失败" /><TextBlock x:Name="InjectionFailuresValue" FontSize="24" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource SettingsCardStyle}" Padding="16">
                        <StackPanel Spacing="4"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="配置代次" /><TextBlock x:Name="SettingsGenerationValue" FontSize="24" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="配置与错误" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock FontWeight="SemiBold" Text="配置文件" />
                        <TextBox x:Name="SettingsPathText" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" />
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <TextBlock FontWeight="SemiBold" Text="最近错误" />
                        <TextBlock x:Name="LastErrorText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <InfoBar
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="失败时优先保留原生滚动"
                Message="未知应用、事件队列已满、目标进程不可访问或注入失败时，引擎会直接放行输入，避免鼠标滚轮失效。" />
        </StackPanel>
    </ScrollViewer>
</Page>
