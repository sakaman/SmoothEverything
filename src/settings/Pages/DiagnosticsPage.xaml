<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SmoothEverything.Settings.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled">
        <Grid HorizontalAlignment="Stretch">
        <StackPanel MaxWidth="980" Margin="32,28,32,48" Spacing="22" HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Diagnostics" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Inspect the engine connection, input counters, and fail-open status." />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Center" Content="Start Engine" Click="StartEngine_Click" />
                <Button Grid.Column="2" VerticalAlignment="Center" Content="Refresh" Click="Refresh_Click" />
            </Grid>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="EngineStatusIcon" Glyph="&#xE9D9;" FontSize="28" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock x:Name="EngineStatusTitle" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="EngineStatusDetail" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Current Run Statistics" />
                <Grid ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource SettingsCardStyle}" Padding="16">
                        <StackPanel Spacing="4"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Physical input" /><TextBlock x:Name="PhysicalEventsValue" FontSize="24" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SettingsCardStyle}" Padding="16">
                        <StackPanel Spacing="4"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Smoothed" /><TextBlock x:Name="SmoothedEventsValue" FontSize="24" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource SettingsCardStyle}" Padding="16">
                        <StackPanel Spacing="4"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Passed through" /><TextBlock x:Name="PassedEventsValue" FontSize="24" FontWeight="SemiBold" /></StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource SettingsCardStyle}" Padding="16">
                        <StackPanel Spacing="4"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Injected frames" /><TextBlock x:Name="InjectedEventsValue" FontSize="24" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingsCardStyle}" Padding="16">
                        <StackPanel Spacing="4"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Injected displacement" /><TextBlock x:Name="InjectedDeltaValue" FontSize="24" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource SettingsCardStyle}" Padding="16">
                        <StackPanel Spacing="4"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Target changes" /><TextBlock x:Name="TargetChangesValue" FontSize="24" FontWeight="SemiBold" /></StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource SettingsCardStyle}" Padding="16">
                        <StackPanel Spacing="4"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Queue overflows" /><TextBlock x:Name="QueueOverflowsValue" FontSize="24" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource SettingsCardStyle}" Padding="16">
                        <StackPanel Spacing="4"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Injection failures" /><TextBlock x:Name="InjectionFailuresValue" FontSize="24" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource SettingsCardStyle}" Padding="16">
                        <StackPanel Spacing="4"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Settings generation" /><TextBlock x:Name="SettingsGenerationValue" FontSize="24" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Settings and Errors" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock FontWeight="SemiBold" Text="Settings File" />
                        <TextBox x:Name="SettingsPathText" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" />
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <TextBlock FontWeight="SemiBold" Text="Latest Error" />
                        <TextBlock x:Name="LastErrorText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <InfoBar
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="Preserve native scrolling on failure"
                Message="The engine passes input through when an application is unknown, the event queue is full, a target process is inaccessible, or injection fails, so the wheel continues to work." />
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
