<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SmoothEverything.Settings.Pages.AdvancedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled">
        <Grid HorizontalAlignment="Stretch">
        <StackPanel MaxWidth="980" Margin="32,28,32,48" Spacing="22" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="高级" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="输入兼容、方向与系统集成选项。" />
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="横向滚动" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="18">
                        <ToggleSwitch
                            x:Name="HorizontalToggle"
                            Header="平滑横向滚轮"
                            OffContent="原样放行"
                            OnContent="启用"
                            Tag="horizontal"
                            Toggled="SettingToggle_Toggled" />
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <ToggleSwitch
                            x:Name="ShiftHorizontalToggle"
                            Header="Shift + 垂直滚轮转为横向滚动"
                            OffContent="关闭"
                            OnContent="启用"
                            Tag="shift-horizontal"
                            Toggled="SettingToggle_Toggled" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="输入兼容" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="18">
                        <ToggleSwitch
                            x:Name="CtrlPassToggle"
                            Header="按住 Ctrl 时直接放行"
                            OffContent="仍平滑"
                            OnContent="直接放行"
                            Tag="ctrl"
                            Toggled="SettingToggle_Toggled" />
                        <TextBlock Margin="0,-12,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="保留浏览器缩放、画布缩放等 Ctrl + 滚轮操作。" TextWrapping="Wrap" />
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <ToggleSwitch
                            x:Name="AltPassToggle"
                            Header="按住 Alt 时直接放行"
                            OffContent="仍平滑"
                            OnContent="直接放行"
                            Tag="alt"
                            Toggled="SettingToggle_Toggled" />
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <ToggleSwitch
                            x:Name="HighResolutionToggle"
                            Header="绕过高分辨率输入"
                            OffContent="统一平滑"
                            OnContent="直接放行"
                            Tag="high-resolution"
                            Toggled="SettingToggle_Toggled" />
                        <TextBlock Margin="0,-12,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="小于标准滚轮刻度的精细输入通常已由触控板或鼠标固件平滑，默认不做二次处理。" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="方向" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="8">
                        <ToggleSwitch
                            x:Name="ReverseToggle"
                            Header="反转滚动方向"
                            OffContent="传统方向"
                            OnContent="自然方向"
                            Tag="reverse"
                            Toggled="SettingToggle_Toggled" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="同时作用于纵向和横向的平滑事件。" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="系统集成" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="18">
                        <ToggleSwitch
                            x:Name="StartupToggle"
                            Header="登录 Windows 后启动"
                            OffContent="手动启动"
                            OnContent="自动启动"
                            Tag="startup"
                            Toggled="SettingToggle_Toggled" />
                        <TextBlock Margin="0,-12,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="使用当前用户的登录启动项，不安装系统服务，也不需要管理员权限。" TextWrapping="Wrap" />
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <ToggleSwitch
                            x:Name="TrayToggle"
                            Header="显示通知区域图标"
                            OffContent="隐藏"
                            OnContent="显示"
                            Tag="tray"
                            Toggled="SettingToggle_Toggled" />
                        <TextBlock Margin="0,-12,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="托盘菜单提供启用、打开设置和退出；Ctrl + Alt + S 可随时切换。" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
