<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SmoothEverything.Settings.Pages.AdvancedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled">
        <Grid HorizontalAlignment="Stretch">
        <StackPanel MaxWidth="980" Margin="32,28,32,48" Spacing="22" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Advanced" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Input compatibility, direction, and system integration options." />
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Horizontal Scrolling" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="18">
                        <ToggleSwitch
                            x:Name="HorizontalToggle"
                    Header="Smooth horizontal wheel input"
                    OffContent="Pass through"
                    OnContent="Enabled"
                            Tag="horizontal"
                            Toggled="SettingToggle_Toggled" />
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <ToggleSwitch
                            x:Name="ShiftHorizontalToggle"
                    Header="Convert Shift + vertical wheel to horizontal"
                    OffContent="Disabled"
                    OnContent="Enabled"
                            Tag="shift-horizontal"
                            Toggled="SettingToggle_Toggled" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Input Compatibility" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="18">
                        <ToggleSwitch
                            x:Name="CtrlPassToggle"
                    Header="Pass through while Ctrl is held"
                    OffContent="Smooth"
                    OnContent="Pass through"
                            Tag="ctrl"
                            Toggled="SettingToggle_Toggled" />
                <TextBlock Margin="0,-12,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Preserves Ctrl + wheel actions such as browser and canvas zoom." TextWrapping="Wrap" />
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <ToggleSwitch
                            x:Name="AltPassToggle"
                    Header="Pass through while Alt is held"
                    OffContent="Smooth"
                    OnContent="Pass through"
                            Tag="alt"
                            Toggled="SettingToggle_Toggled" />
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <ToggleSwitch
                            x:Name="HighResolutionToggle"
                    Header="Bypass high-resolution input"
                    OffContent="Smooth all input"
                    OnContent="Pass through"
                            Tag="high-resolution"
                            Toggled="SettingToggle_Toggled" />
                <TextBlock Margin="0,-12,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Fine input below a standard wheel step is usually smoothed by the touchpad or mouse firmware and passes through by default." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Direction" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="8">
                        <ToggleSwitch
                            x:Name="ReverseToggle"
                    Header="Reverse scrolling direction"
                    OffContent="Traditional"
                    OnContent="Natural"
                            Tag="reverse"
                            Toggled="SettingToggle_Toggled" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Applies to vertical and horizontal smoothed events." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="System Integration" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="18">
                        <ToggleSwitch
                            x:Name="StartupToggle"
                    Header="Start after Windows sign-in"
                    OffContent="Manual"
                    OnContent="Automatic"
                            Tag="startup"
                            Toggled="SettingToggle_Toggled" />
                <TextBlock Margin="0,-12,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Uses a per-user startup entry without installing a system service or requiring administrator privileges." TextWrapping="Wrap" />
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <ToggleSwitch
                            x:Name="TrayToggle"
                    Header="Show notification-area icon"
                    OffContent="Hidden"
                    OnContent="Shown"
                            Tag="tray"
                            Toggled="SettingToggle_Toggled" />
                <TextBlock Margin="0,-12,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="The tray menu provides enable, settings, and exit commands; Ctrl + Alt + S toggles smoothing at any time." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
