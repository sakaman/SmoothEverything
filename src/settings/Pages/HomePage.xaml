<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SmoothEverything.Settings.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled">
        <Grid HorizontalAlignment="Stretch">
            <StackPanel
                MaxWidth="980"
                Margin="32,28,32,48"
                HorizontalAlignment="Stretch"
                Spacing="22">
                <StackPanel Spacing="6">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Scrolling Experience" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Add continuous, low-latency native smoothing to a traditional mouse wheel."
                        TextWrapping="Wrap" />
                </StackPanel>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="5">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Global Smoothing" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="When paused, wheel events pass through to the target application unchanged."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="5">
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Engine Status" />
                            <ToggleSwitch
                                x:Name="EnabledToggle"
                                HorizontalAlignment="Right"
                        OffContent="Paused"
                        OnContent="Enabled"
                                Toggled="EnabledToggle_Toggled" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Motion Presets" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource PresetButtonStyle}" Content="Responsive" Tag="responsive" Click="Preset_Click" />
                        <Button Grid.Column="1" Style="{StaticResource PresetButtonStyle}" Content="Balanced" Tag="balanced" Click="Preset_Click" />
                        <Button Grid.Column="2" Style="{StaticResource PresetButtonStyle}" Content="Smooth Tail" Tag="smooth" Click="Preset_Click" />
                        <Button Grid.Column="3" Style="{StaticResource PresetButtonStyle}" Content="Classic" Tag="classic" Click="Preset_Click" />
                    </Grid>
                </StackPanel>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Motion Settings" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Changes are saved automatically and applied to the background engine immediately." />
                        </StackPanel>

                        <Grid ColumnSpacing="32" RowSpacing="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Scroll distance" />
                                    <Border Grid.Column="1" Style="{StaticResource ValuePillStyle}"><TextBlock x:Name="DistanceValue" FontSize="12" FontWeight="SemiBold" /></Border>
                                </Grid>
                                <Slider
                                    x:Name="DistanceSlider"
                                    AutomationProperties.Name="Scroll distance"
                                    Maximum="4"
                                    Minimum="0.1"
                                    StepFrequency="0.05"
                                    Value="1"
                                    ValueChanged="MotionSlider_ValueChanged" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Animation duration" />
                                    <Border Grid.Column="1" Style="{StaticResource ValuePillStyle}"><TextBlock x:Name="DurationValue" FontSize="12" FontWeight="SemiBold" /></Border>
                                </Grid>
                                <Slider
                                    x:Name="DurationSlider"
                                    AutomationProperties.Name="Animation duration"
                                    Maximum="1000"
                                    Minimum="40"
                                    StepFrequency="10"
                                    Value="360"
                                    ValueChanged="MotionSlider_ValueChanged" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Acceleration window" />
                                    <Border Grid.Column="1" Style="{StaticResource ValuePillStyle}"><TextBlock x:Name="AccelerationWindowValue" FontSize="12" FontWeight="SemiBold" /></Border>
                                </Grid>
                                <Slider
                                    x:Name="AccelerationWindowSlider"
                                    AutomationProperties.Name="Acceleration window"
                                    Maximum="300"
                                    Minimum="0"
                                    StepFrequency="5"
                                    ValueChanged="MotionSlider_ValueChanged" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Maximum acceleration" />
                                    <Border Grid.Column="1" Style="{StaticResource ValuePillStyle}"><TextBlock x:Name="AccelerationMaxValue" FontSize="12" FontWeight="SemiBold" /></Border>
                                </Grid>
                                <Slider
                                    x:Name="AccelerationMaxSlider"
                                    AutomationProperties.Name="Maximum acceleration"
                                    Maximum="20"
                                    Minimum="1"
                                    StepFrequency="0.5"
                                    Value="7"
                                    ValueChanged="MotionSlider_ValueChanged" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Tail / head ratio" />
                                    <Border Grid.Column="1" Style="{StaticResource ValuePillStyle}"><TextBlock x:Name="TailRatioValue" FontSize="12" FontWeight="SemiBold" /></Border>
                                </Grid>
                                <Slider
                                    x:Name="TailRatioSlider"
                                    AutomationProperties.Name="Tail to head ratio"
                                    Maximum="10"
                                    Minimum="0.1"
                                    StepFrequency="0.1"
                                    Value="3"
                                    ValueChanged="MotionSlider_ValueChanged" />
                            </StackPanel>

                            <Border
                                Grid.Row="2"
                                Grid.Column="1"
                                Padding="14"
                                VerticalAlignment="Stretch"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock FontWeight="SemiBold" Text="Easing Curve" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Makes starts and endings feel more natural"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        x:Name="EasingToggle"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        OffContent=""
                                        OnContent=""
                                        Toggled="EasingToggle_Toggled" />
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Test Scrolling Area" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Move the pointer over the list below and scroll to feel the current settings." />
                    <Border Style="{StaticResource SettingsCardStyle}" Padding="8">
                        <ScrollViewer Height="230" VerticalScrollBarVisibility="Visible">
                            <StackPanel Spacing="8" Padding="8">
                        <Border Padding="16" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><TextBlock Text="01  Scroll one step gently to observe the initial response" /></Border>
                        <Border Padding="16" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><TextBlock Text="02  Scroll repeatedly to observe acceleration stacking" /></Border>
                        <Border Padding="16" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><TextBlock Text="03  Reverse direction to cancel existing momentum immediately" /></Border>
                        <Border Padding="16" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><TextBlock Text="04  Reduce duration for a more direct feel" /></Border>
                        <Border Padding="16" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><TextBlock Text="05  Increase the tail ratio for a softer ending" /></Border>
                        <Border Padding="16" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><TextBlock Text="06  Settings save automatically after interaction stops" /></Border>
                        <Border Padding="16" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><TextBlock Text="07  High-resolution touchpad input passes through by default" /></Border>
                        <Border Padding="16" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><TextBlock Text="08  Application rules can override global settings" /></Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
